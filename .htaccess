RewriteEngine On

# 1. Keamanan: Blokir akses langsung ke file sensitif
<FilesMatch "\.(sql|zip|tar|gz|log|env|bak|config|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir akses ke file/folder tersembunyi (seperti .git, .env)
RewriteCond %{SCRIPT_FILENAME} -d [OR]
RewriteCond %{SCRIPT_FILENAME} -f
RewriteRule "(^|/)\." - [F]

# 2. Mengarahkan error 404 ke halaman kustom
ErrorDocument 404 /404.html

# 3. Handle halaman listing produk (produk/ atau produk)
RewriteRule ^produk/?$ produk.html [L]

# 4. Rewrite produk/SLUG menjadi produk.html?slug=SLUG
RewriteRule ^produk/([a-zA-Z0-9-]+)/?$ produk.html?slug=$1 [L,QSA]

# 5. Menghilangkan ekstensi .php (Pretty URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 6. Menghilangkan ekstensi .html (Pretty URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
